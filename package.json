{
  "name": "ros2-visual-starter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "22.x",
    "npm": ">=10 <11"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/public-release/public-release.test.mjs",
    "test:watch": "vitest --exclude tests/public-release/public-release.test.mjs",
    "preview": "vite preview",
    "test-backend": "python3 -m pytest backend/tests"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "roslib": "^2.1.0",
    "three": "^0.185.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/three": "^0.178.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
